def main(west, south, east, north, cloud_cover_max, days_back, output_dir):
    import numpy as np
    import pandas as pd
    import xarray as xr
    from datetime import datetime, timedelta
    from pystac_client import Client
    from pystac_client.stac_api_io import StacApiIO
    import stackstac
    import rioxarray
    import warnings
    warnings.filterwarnings('ignore')
    cwl_requirements = {'NetworkAccess': {'networkAccess': True},
        'ResourceRequirement': {'coresMin': 2, 'ramMin': 4096, 'tmpdirMin':
        1024}}
    cwl_metadata = {'s:softwareVersion': '0.0.1', 's:keywords': ['ospd',
        'mangrove', 'biomass'], 's:author': [{'class': 's:Person', 's:name':
        'Cameron Sajedi'}], 's:codeRepository':
        'https://github.com/starling-foundries/KindGrove', 's:license':
        'https://spdx.org/licenses/CC-BY-NC-SA-4.0', 's:description':
        'Workflow for analyzing mangrove biomass using Sentinel-2 satellite imagery'
        }
    cwl_namespaces = {'s': 'https://schema.org/', 'edam':
        'http://edamontology.org/', 'iana':
        'https://www.iana.org/assignments/media-types/'}
    import os
    os.makedirs(output_dir, exist_ok=True)
    print(f'Output directory: {output_dir}')
    result = output_dir
    print(f'Searching for Sentinel-2 scenes...')
    print(f'Bounds: ({west}, {south}) to ({east}, {north})')
    print(f'Max cloud cover: {cloud_cover_max}%')
    catalog = Client.open('https://earth-search.aws.element84.com/v1', stac_io=StacApiIO(timeout=60, max_retries=3))
    bbox = [west, south, east, north]
    end_date = datetime.now()
    start_date = end_date - timedelta(days=days_back)
    search = catalog.search(collections=['sentinel-2-l2a'], bbox=bbox,
        datetime=f'{start_date.isoformat()}/{end_date.isoformat()}', query=
        {'eo:cloud_cover': {'lt': cloud_cover_max}})
    items = list(search.items())
    print(f'Found {len(items)} scenes')
    if len(items) == 0:
        raise ValueError(
            f'No scenes found with <{cloud_cover_max}% cloud cover')
    # Bounded network: every byte-range read has a timeout and a retry budget, and a scene that
    # cannot be fetched inside it is skipped for the next candidate. A job fails loudly, never hangs.
    import threading as _threading

    def _with_deadline(fn, seconds=600):
        # Hard ceiling on one scene: the per-request budget catches a slow read, this catches a wedged worker
        _box = {}
        def _run():
            try:
                _box['value'] = fn()
            except BaseException as _e:
                _box['error'] = _e
        _t = _threading.Thread(target=_run, daemon=True)
        _t.start()
        _t.join(seconds)
        if _t.is_alive():
            raise TimeoutError(f'no result after {seconds}s; abandoning this scene')
        if 'error' in _box:
            raise _box['error']
        return _box['value']
    _gdal_env = stackstac.DEFAULT_GDAL_ENV.updated(always={'GDAL_HTTP_TIMEOUT': 60, 'GDAL_HTTP_CONNECTTIMEOUT': 30, 'GDAL_HTTP_MAX_RETRY': 3, 'GDAL_HTTP_RETRY_DELAY': 5})
    _candidates = sorted(items, key=lambda x: x.properties.get('eo:cloud_cover', 100))[:3]
    _reasons = []
    for best_item in _candidates:
        print(f"Selected scene: {best_item.datetime.strftime('%Y-%m-%d')}")
        print(f"Cloud cover: {best_item.properties.get('eo:cloud_cover', 'N/A'):.1f}%")
        print('Downloading bands (red, green, nir)...')
        try:
            sentinel2_lazy = stackstac.stack([best_item], assets=['red', 'green', 'nir'], epsg=4326,
                resolution=0.0001, chunksize=(1, 1, 2048, 2048), gdal_env=_gdal_env)
            sentinel2_full = _with_deadline(sentinel2_lazy.compute)
            break
        except Exception as _e:
            _reasons.append(f'{best_item.id}: {type(_e).__name__}: {str(_e)[:160]}')
            print(f'Scene could not be fetched within the network budget; trying the next candidate ({_reasons[-1]})')
    else:
        print('Earth Search: none of the candidate scenes could be fetched within the time budget: ' + '; '.join(_reasons), flush=True)
        import os as _os
        _os._exit(1)  # a wedged worker thread must not keep the process alive after the failure is reported
    sentinel2_data = sentinel2_full.sel(x=slice(bbox[0], bbox[2]), y=slice(
        bbox[3], bbox[1]))
    print(f'Data shape: {sentinel2_data.shape}')
    print('Calculating vegetation indices...')
    if 'time' in sentinel2_data.dims:
        red = sentinel2_data.sel(band='red').isel(time=0).values
        green = sentinel2_data.sel(band='green').isel(time=0).values
        nir = sentinel2_data.sel(band='nir').isel(time=0).values
    else:
        red = sentinel2_data.sel(band='red').values
        green = sentinel2_data.sel(band='green').values
        nir = sentinel2_data.sel(band='nir').values
    ndvi = (nir - red) / (nir + red + 1e-08)
    ndwi = (green - nir) / (green + nir + 1e-08)
    savi = (nir - red) / (nir + red + 0.5) * 1.5
    print(f'NDVI range: {np.nanmin(ndvi):.3f} to {np.nanmax(ndvi):.3f}')
    print('Detecting mangroves...')
    mangrove_mask = ((ndvi > 0.3) & (ndvi < 0.9) & (ndwi > -0.3) & (savi > 0.2)
        ).astype(float)
    pixel_area_m2 = 10 * 10
    mangrove_pixels = np.sum(mangrove_mask)
    mangrove_area_ha = mangrove_pixels * pixel_area_m2 / 10000
    print(f'Detected mangrove area: {mangrove_area_ha:.1f} hectares')
    print(
        f'Coverage: {mangrove_pixels / mangrove_mask.size * 100:.1f}% of study area'
        )
    print('Estimating biomass...')
    biomass = 250.5 * ndvi - 75.2
    biomass_masked = np.where(mangrove_mask > 0, biomass, np.nan)
    biomass_masked = np.maximum(biomass_masked, 0)
    valid_biomass = biomass_masked[~np.isnan(biomass_masked)]
    if len(valid_biomass) > 0:
        mean_biomass = np.mean(valid_biomass)
        median_biomass = np.median(valid_biomass)
        max_biomass = np.max(valid_biomass)
        std_biomass = np.std(valid_biomass)
        print(f'Mean biomass: {mean_biomass:.1f} Mg/ha')
        print(f'Median biomass: {median_biomass:.1f} Mg/ha')
        print(f'Max biomass: {max_biomass:.1f} Mg/ha')
    else:
        print('Warning: No valid biomass estimates')
        mean_biomass = 0
        median_biomass = 0
        max_biomass = 0
        std_biomass = 0
    print('Calculating carbon stocks...')
    pixel_area_ha = 10 * 10 / 10000
    total_biomass_mg = np.sum(valid_biomass) * pixel_area_ha if len(
        valid_biomass) > 0 else 0
    carbon_stock_mg = total_biomass_mg * 0.47
    co2_equivalent_mg = carbon_stock_mg * 3.67
    print(f'Total biomass: {total_biomass_mg:,.0f} Mg')
    print(f'Carbon stock: {carbon_stock_mg:,.0f} Mg C')
    print(f'CO2 equivalent: {co2_equivalent_mg:,.0f} Mg CO2')
    biomass_summary_path = os.path.join(output_dir, 'biomass_summary.csv')
    biomass_df = pd.DataFrame([{'Metric': 'Mangrove Area (ha)', 'Value':
        f'{mangrove_area_ha:.1f}'}, {'Metric': 'Mean Biomass (Mg/ha)',
        'Value': f'{mean_biomass:.1f}'}, {'Metric':
        'Median Biomass (Mg/ha)', 'Value': f'{median_biomass:.1f}'}, {
        'Metric': 'Max Biomass (Mg/ha)', 'Value': f'{max_biomass:.1f}'}, {
        'Metric': 'Std Deviation (Mg/ha)', 'Value': f'{std_biomass:.1f}'}])
    biomass_df.to_csv(biomass_summary_path, index=False)
    print(f'Saved: {biomass_summary_path}')
    carbon_summary_path = os.path.join(output_dir, 'carbon_summary.csv')
    carbon_df = pd.DataFrame([{'Metric': 'Total Biomass (Mg)', 'Value':
        f'{total_biomass_mg:,.0f}'}, {'Metric': 'Carbon Stock (Mg C)',
        'Value': f'{carbon_stock_mg:,.0f}'}, {'Metric':
        'CO2 Equivalent (Mg CO2)', 'Value': f'{co2_equivalent_mg:,.0f}'}, {
        'Metric': 'Carbon Density (Mg C/ha)', 'Value':
        f'{carbon_stock_mg / mangrove_area_ha if mangrove_area_ha > 0 else 0:.1f}'
        }, {'Metric': 'Analysis Date', 'Value': datetime.now().strftime(
        '%Y-%m-%d')}, {'Metric': 'Scene Date', 'Value': best_item.datetime.
        strftime('%Y-%m-%d')}, {'Metric': 'Cloud Cover (%)', 'Value':
        f"{best_item.properties.get('eo:cloud_cover', 'N/A'):.1f}"}, {
        'Metric': 'Uncertainty', 'Value': '±30%'}])
    carbon_df.to_csv(carbon_summary_path, index=False)
    print(f'Saved: {carbon_summary_path}')
    mangrove_mask_path = os.path.join(output_dir, 'mangrove_mask.tif')
    if 'x' in sentinel2_data.coords and 'y' in sentinel2_data.coords:
        mask_xr = xr.DataArray(mangrove_mask, dims=['y', 'x'], coords={'x':
            sentinel2_data.coords['x'].values, 'y': sentinel2_data.coords[
            'y'].values})
        mask_xr = mask_xr.rio.write_crs('EPSG:4326')
        mask_xr.rio.to_raster(mangrove_mask_path, compress='lzw')
        print(f'Saved: {mangrove_mask_path}')
    else:
        print('Warning: Could not export GeoTIFF (missing coordinates)')
        np.savetxt(mangrove_mask_path.replace('.tif', '.csv'),
            mangrove_mask, delimiter=',', fmt='%.0f')
        print(
            f"Saved as CSV instead: {mangrove_mask_path.replace('.tif', '.csv')}"
            )
    print('Creating STAC catalog with organized assets...')
    import pystac
    import shutil
    import json
    catalog = pystac.Catalog(id='mangrove-biomass-analysis', description=
        'Mangrove biomass and carbon analysis from Sentinel-2 imagery',
        title='Mangrove Biomass Analysis')
    collection = pystac.Collection(id='mangrove-results', description=
        'Analysis results including biomass estimates and carbon storage',
        title='Mangrove Analysis Results', extent=pystac.Extent(spatial=
        pystac.SpatialExtent(bboxes=[bbox]), temporal=pystac.TemporalExtent
        (intervals=[[datetime.now(), None]])))
    item_id = f"mangrove-analysis-{datetime.now().strftime('%Y%m%d-%H%M%S')}"

    # Item geometry: the footprint of the pixels the numbers were computed on (the scene's valid
    # data inside the request), not the request box. A number carries its ground.
    from rasterio.features import shapes as _shapes
    from shapely.geometry import shape as _shape, mapping as _mapping, box as _box
    from shapely.ops import unary_union as _unary_union
    _valid = np.isfinite(red) & np.isfinite(nir) & np.isfinite(ndvi)
    if 'x' in sentinel2_data.coords and 'y' in sentinel2_data.coords and _valid.any():
        _valid_xr = xr.DataArray(_valid.astype('uint8'), dims=['y', 'x'], coords={'x': sentinel2_data.coords['x'].values, 'y': sentinel2_data.coords['y'].values}).rio.write_crs('EPSG:4326')
        _parts = [_shape(g) for g, v in _shapes(_valid.astype('uint8'), mask=_valid, transform=_valid_xr.rio.transform()) if v == 1]
        footprint = _unary_union(_parts).simplify(0.0002, preserve_topology=True)
    else:
        footprint = _box(bbox[0], bbox[1], bbox[2], bbox[3])
    print(f'Valid-data footprint: {100 * _valid.mean():.1f}% of the request box')
    item_geometry = _mapping(footprint)
    item_bbox = list(footprint.bounds)
    item = pystac.Item(id=item_id, geometry=item_geometry, bbox=item_bbox,
        datetime=datetime.now(), properties={'scene_id': best_item.id,
        'cloud_cover': best_item.properties.get('eo:cloud_cover'),
        'mangrove_area_ha': mangrove_area_ha, 'biomass_tons':
        total_biomass_mg, 'carbon_tons': carbon_stock_mg})
    mangrove_results_dir = os.path.join(output_dir)
    item_dir = os.path.join(mangrove_results_dir, item_id)
    os.makedirs(item_dir, exist_ok=True)
    print(f'Created organized directory: {item_dir}')
    print('Moving files to organized STAC structure...')
    file_moves = [(os.path.join(output_dir, 'mangrove_mask.tif'), os.path.
        join(item_dir, 'mangrove_mask.tif')), (os.path.join(output_dir,
        'biomass_summary.csv'), os.path.join(item_dir,
        'biomass_summary.csv')), (os.path.join(output_dir,
        'carbon_summary.csv'), os.path.join(item_dir, 'carbon_summary.csv'))]
    for src_path, dst_path in file_moves:
        if os.path.exists(src_path):
            shutil.move(src_path, dst_path)
            print(f'  Moved: {os.path.basename(src_path)} -> {item_id}/')
    asset_files = {'mangrove_mask.tif': 'Mangrove detection mask',
        'biomass_summary.csv': 'Biomass analysis summary',
        'carbon_summary.csv': 'Carbon storage analysis'}
    print('Adding assets to STAC item...')
    for filename, description in asset_files.items():
        dst_path = os.path.join(item_dir, filename)
        if os.path.exists(dst_path):
            print(f'  Adding asset: {filename}')
            if filename.endswith('.tif'):
                media_type = 'image/tiff'
            elif filename.endswith('.csv'):
                media_type = 'text/csv'
            else:
                media_type = 'application/octet-stream'
            item.add_asset(key=filename.replace('.', '_'), asset=pystac.
                Asset(href=filename, media_type=media_type, title=description))
    catalog.add_item(item)
    print('Saving STAC catalog with organized structure...')
    catalog.normalize_and_save(root_href=output_dir, catalog_type=pystac.
        CatalogType.SELF_CONTAINED)
    catalog_path = os.path.join(output_dir, 'catalog.json')
    print(f'STAC catalog created successfully!')
    print(f'Catalog saved to: {catalog_path}')
    print('Workflow completed successfully!')
    print(f'Results saved in: {output_dir}')
    print(
        f"STAC catalog available at: {os.path.join(output_dir, 'catalog.json')}"
        )


